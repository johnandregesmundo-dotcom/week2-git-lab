mkdir ~/devops-projects/week2-git-lab/log-analyzer && cd $_

# Gumawa ng sample log file
cat > sample.log <<'EOF'
2024-01-15 10:23:45 INFO Server started successfully
2024-01-15 10:24:12 ERROR Connection timeout to db-server
2024-01-15 10:24:15 WARN High memory usage: 85%
2024-01-15 10:25:01 INFO User login: juan
2024-01-15 10:25:30 ERROR Failed to write to disk
2024-01-15 10:26:00 INFO Backup completed
2024-01-15 10:26:45 ERROR Database connection lost
2024-01-15 10:27:10 WARN CPU usage: 90%
2024-01-15 10:28:00 INFO User logout: juan
2024-01-15 10:30:00 ERROR Out of memory
EOF

# Practice commands
grep "ERROR" sample.log                    # Find errors
grep -c "ERROR" sample.log                 # Count errors
grep "ERROR" sample.log | wc -l            # Same
grep "WARN" sample.log                     # Find warnings
grep -E "(ERROR|WARN)" sample.log          # Find both
grep -v "INFO" sample.log                  # Exclude INFO

# AWK magic
awk '/ERROR/ {print $1, $2, $4}' sample.log           # Date + error message
awk '{print $3}' sample.log | sort | uniq -c          # Count by log level
awk '/ERROR/ {count++} END {print "Total errors:", count}' sample.log

# SED
sed 's/ERROR/❌ ERROR/' sample.log          # Visual markers
sed -n '1,5p' sample.log                   # First 5 lines
sed '/INFO/d' sample.log                   # Remove INFO lines
🎯 MAIN PROJECT: log-analyzer.sh
bash
cat > log-analyzer.sh <<'EOF'
#!/bin/bash

# log-analyzer.sh - Analyze log files
# DevOps Apprentice - Week 2 Day 4

LOG_FILE=$1

if [ -z "$LOG_FILE" ]; then
    echo "Usage: $0 <logfile>"
    exit 1
fi

if [ ! -f "$LOG_FILE" ]; then
    echo "Error: $LOG_FILE not found!"
    exit 1
fi

echo "=========================================="
echo "     LOG ANALYSIS REPORT"
echo "=========================================="
echo "File: $LOG_FILE"
echo "Generated: $(date)"
echo ""

# Total lines
TOTAL=$(wc -l < "$LOG_FILE")
echo "📊 Total log entries: $TOTAL"

# Count by level
echo ""
echo "📈 Log Level Distribution:"
echo "-------------------------"
grep -c "INFO" "$LOG_FILE" 2>/dev/null | xargs -I{} echo "  INFO:    {}"
grep -c "WARN" "$LOG_FILE" 2>/dev/null | xargs -I{} echo "  WARN:    {}"
grep -c "ERROR" "$LOG_FILE" 2>/dev/null | xargs -I{} echo "  ERROR:   {}"

# Error details
echo ""
echo "❌ Error Details:"
echo "-----------------"
grep "ERROR" "$LOG_FILE" | while read -r line; do
    timestamp=$(echo "$line" | awk '{print $1, $2}')
    message=$(echo "$line" | cut -d' ' -f4-)
    echo "  [$timestamp] $message"
done

# Summary
ERROR_COUNT=$(grep -c "ERROR" "$LOG_FILE" 2>/dev/null || echo 0)
WARN_COUNT=$(grep -c "WARN" "$LOG_FILE" 2>/dev/null || echo 0)

echo ""
echo "🚨 ALERTS:"
if [ "$ERROR_COUNT" -gt 3 ]; then
    echo "  ⚠️ High error count: $ERROR_COUNT"
fi
if [ "$WARN_COUNT" -gt 2 ]; then
    echo "  ⚠️ Elevated warnings: $WARN_COUNT"
fi

echo ""
echo "=========================================="
EOF

